# C++ 编译产物
*.o
*.obj
*.exe
*.dll
*.so
*.dylib
*.a
*.lib
*.pdb
*.ilk
*.idb
*.exp
*.map
*.tlog
*.lastbuildstate
*.unsuccessfulbuild

# Qt 相关文件
*.pro.user
*.pro.user.*
*.qbs.user
*.qbs.user.*
moc_*.cpp
moc_*.h
qrc_*.cpp
ui_*.h
*.qm
*.ts~

# CMake 构建文件
build/
out/
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
install_manifest.txt
CMakeDoxyfile.in
CMakeDoxygenDefaults.cmake

# Visual Studio 相关
*.vcxproj
*.vcxproj.filters
*.vcxproj.user
*.sln
*.suo
*.user
*.userosscache
*.sln.docstates
.vs/

# IDE 配置文件（保留 .vscode/settings.json）
.idea/
*.swp
*.swo
*~
.vscode/launch.json
.vscode/tasks.json
.vscode/c_cpp_properties.json
.vscode/extensions.json

# 调试和分析工具
*.dSYM/
*.su
*.idb
*.pdb
valgrind-out.txt

# 临时文件
*.tmp
*.temp
*.log
*.bak
*.swp
*.swo
*~

# 系统文件
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# 包管理器
node_modules/
*.tgz
*.tar.gz

# 文档生成
docs/html/
docs/latex/
doxygen_warnings.txt

# 测试覆盖率
*.gcov
*.gcda
*.gcno
coverage/

# 打包文件
*.zip
*.rar
*.7z
*.tar
*.gz
*.bz2
*.xz

# 自定义构建目录
release/
debug/
dist/